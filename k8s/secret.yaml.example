# Example Kubernetes Secret configuration
# Copy this file to secret.yaml and update values before applying:
# kubectl apply -f k8s/secret.yaml -n wanderlust

apiVersion: v1
kind: Secret
metadata:
  name: wanderlust-secret
  namespace: wanderlust
  labels:
    app.kubernetes.io/name: wanderlust
type: Opaque
stringData:
  ATLASDB_URL: "mongodb://mongodb-service:27017/wanderlust"
  SECRET: "your_super_secret_session_key_here"
  CLOUD_NAME: "your_cloudinary_cloud_name"
  CLOUD_API_KEY: "your_cloudinary_api_key"
  CLOUD_API_SECRET: "your_cloudinary_api_secret"
